# CloudMail OpenAPI base URL. Replace with your actual CloudMail host.
CLOUDMAIL_BASE_URL=https://your-cloudmail-host/

# CloudMail admin account used to call /api/public/genToken
CLOUDMAIL_ADMIN_EMAIL=admin@example.com
CLOUDMAIL_ADMIN_PASSWORD=change-me

# New mailbox domain used for registration, without the @ prefix.
CLOUDMAIL_DOMAIN=example.com

# Random generator settings
EMAIL_PREFIX_LENGTH=8
REGISTER_PASSWORD_LENGTH=12
DISPLAY_NAME_LENGTH=8

# Mail polling
CLOUDMAIL_POLL_INTERVAL_SECONDS=5
CLOUDMAIL_POLL_TIMEOUT_SECONDS=180

# WindsurfPoolAPI import target
WINDSURF_POOL_API_BASE_URL=http://localhost:3003
